# Clerk (get from https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=

# Optional. In local dev, Vite proxies `/api/*` to `http://localhost:3001`.
# Leave blank for same-origin (recommended for Vercel).
# VITE_API_BASE_URL=http://localhost:3001

# Expo app API base. Unset, this falls back to http://localhost:3001 (iOS Simulator).
# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3001
# Physical Android device: use the host machine's LAN IP, for example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:3001
